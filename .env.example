# Copy to .env and fill in values. All paths can be absolute or relative to project root.
# Default values shown — override only what you need.

# Compute device (use cuda:0, cuda:1, etc. to pin to a specific GPU)
DEVICE=cuda:0

# Directory where model checkpoints are stored
CHECKPOINTS_DIR=./checkpoints

# Directory where pipeline run outputs are written
RUNS_DIR=./data/runs

# Path to SMPL neutral model file (requires manual download from smpl.is.tue.mpg.de)
SMPL_MODEL_PATH=./checkpoints/smpl/SMPL_NEUTRAL.pkl

# Path to SAM 2.1 small checkpoint (download via scripts/download_models.sh)
SAM2_CHECKPOINT=./checkpoints/sam2/sam2.1_hiera_small.pt

# Loguru log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO